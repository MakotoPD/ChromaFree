import { Button, CheckBox, ComboBox, GroupBox, LineEdit, ScrollView, Slider, Switch, TabWidget, VerticalBox, HorizontalBox } from "std-widgets.slint";

component Hint inherits Text {
    wrap: word-wrap;
    font-size: 12px;
    color: #8a8f98;
}

component LabeledSlider inherits VerticalLayout {
    in property <string> label;
    in-out property <float> value;
    in property <bool> active: true;
    callback edited();
    spacing: 2px;
    HorizontalLayout {
        Text {
            text: root.label;
            horizontal-stretch: 1;
        }
        Text {
            text: round(root.value) + " %";
        }
    }
    Slider {
        minimum: 0;
        maximum: 100;
        enabled: root.active;
        value <=> root.value;
        released => {
            root.edited();
        }
    }
}

export component MainWindow inherits Window {
    title: "ChromaFree";
    preferred-width: 1180px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 560px;
    icon: @image-url("../assets/chromafree-256.png");

    in property <image> preview;
    in property <bool> has-preview;
    in property <string> status-text;
    in property <string> detail-text;
    in property <string> virtual-camera-text;
    in property <bool> status-problem;

    in property <[string]> camera-names;
    in-out property <int> camera-index;
    in property <string> camera-message;
    in property <[string]> format-names;
    in-out property <int> format-index;

    in property <[string]> output-names;
    in-out property <int> output-index;
    in property <[string]> fps-names;
    in-out property <int> fps-index;
    in-out property <int> rotation-index;
    in-out property <bool> mirror-horizontal;
    in-out property <bool> mirror-vertical;

    in-out property <int> effect-index;
    in-out property <float> blur-strength;
    in-out property <string> color-text;
    in property <color> color-swatch;
    in property <string> image-path;

    in-out property <int> method-index;
    in property <[string]> quality-names;
    in-out property <int> quality-index;
    in-out property <int> device-index;
    in-out property <float> edge-low;
    in-out property <float> edge-high;
    in-out property <float> smoothing;

    callback settings-edited();
    callback camera-selected();
    callback refresh-cameras();
    callback color-preset(string);
    callback choose-image();
    callback reset-mask();
    in-out property <bool> preview-enabled;
    callback preview-toggled(bool);
    in property <string> app-version;
    in property <string> app-author;
    callback open-project();
    callback open-discord();
    callback open-logs();

    HorizontalBox {
        VerticalBox {
            horizontal-stretch: 3;
            HorizontalLayout {
                spacing: 8px;
                Switch {
                    text: @tr("Live preview");
                    checked <=> root.preview-enabled;
                    toggled => {
                        root.preview-toggled(self.checked);
                    }
                }
                Hint {
                    text: @tr("The preview starts the camera and uses some processor time, so it is off by default.");
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                background: #16181c;
                border-radius: 8px;
                clip: true;
                if root.preview-enabled && root.has-preview: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.preview;
                    image-fit: contain;
                }
                if !root.preview-enabled || !root.has-preview: Text {
                    text: root.preview-enabled ? @tr("Starting the camera…") : @tr("Preview is off");
                    color: #8a8f98;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                background: root.status-problem ? #3a2323 : #1f2a22;
                border-radius: 8px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    Text {
                        text: root.status-text;
                        font-size: 15px;
                        font-weight: 600;
                        color: root.status-problem ? #ffb4ab : #b8f0c4;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.detail-text;
                        color: #c9ccd1;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.virtual-camera-text;
                        color: #c9ccd1;
                        wrap: word-wrap;
                    }
                }
            }
        }

        TabWidget {
            horizontal-stretch: 2;
            min-width: 380px;

            Tab {
                title: @tr("Camera");
                ScrollView {
                    VerticalBox {
                        alignment: start;
                        GroupBox {
                            title: @tr("Input camera");
                            VerticalBox {
                                HorizontalBox {
                                    padding: 0;
                                    ComboBox {
                                        horizontal-stretch: 1;
                                        model: root.camera-names;
                                        current-index <=> root.camera-index;
                                        selected => {
                                            root.camera-selected();
                                        }
                                    }
                                    Button {
                                        text: @tr("Refresh");
                                        clicked => {
                                            root.refresh-cameras();
                                        }
                                    }
                                }
                                if root.camera-message != "": Text {
                                    text: root.camera-message;
                                    color: #ffb4ab;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: @tr("Camera resolution and frame rate");
                                }
                                ComboBox {
                                    model: root.format-names;
                                    current-index <=> root.format-index;
                                    selected => {
                                        root.settings-edited();
                                    }
                                }
                                Hint {
                                    text: @tr("Automatic picks the largest resolution up to 1920×1080 that keeps up with the output frame rate. A higher resolution gives better quality but more scaling work.");
                                }
                            }
                        }
                        GroupBox {
                            title: @tr("Virtual camera output");
                            VerticalBox {
                                HorizontalBox {
                                    padding: 0;
                                    ComboBox {
                                        horizontal-stretch: 2;
                                        model: root.output-names;
                                        current-index <=> root.output-index;
                                        selected => {
                                            root.settings-edited();
                                        }
                                    }
                                    ComboBox {
                                        horizontal-stretch: 1;
                                        model: root.fps-names;
                                        current-index <=> root.fps-index;
                                        selected => {
                                            root.settings-edited();
                                        }
                                    }
                                }
                                Hint {
                                    text: @tr("The virtual camera offers only this resolution. An app that is already using the camera keeps its current resolution and gets the new one after it turns the camera on again.");
                                }
                            }
                        }
                        GroupBox {
                            title: @tr("Orientation");
                            VerticalBox {
                                ComboBox {
                                    model: [@tr("No rotation"), @tr("Rotate 90°"), @tr("Rotate 180°"), @tr("Rotate 270°")];
                                    current-index <=> root.rotation-index;
                                    selected => {
                                        root.settings-edited();
                                    }
                                }
                                CheckBox {
                                    text: @tr("Mirror horizontally");
                                    checked <=> root.mirror-horizontal;
                                    toggled => {
                                        root.settings-edited();
                                    }
                                }
                                CheckBox {
                                    text: @tr("Mirror vertically");
                                    checked <=> root.mirror-vertical;
                                    toggled => {
                                        root.settings-edited();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: @tr("Background");
                ScrollView {
                    VerticalBox {
                        alignment: start;
                        GroupBox {
                            title: @tr("Effect");
                            VerticalBox {
                                ComboBox {
                                    model: [@tr("No effect"), @tr("Blur background"), @tr("Remove background: color"), @tr("Custom background image"), @tr("Remove background: transparency")];
                                    current-index <=> root.effect-index;
                                    selected => {
                                        root.settings-edited();
                                    }
                                }
                                if root.effect-index == 0: Hint {
                                    text: @tr("The camera image without masking. The segmentation model does not run.");
                                }
                                if root.effect-index == 4: Hint {
                                    text: @tr("The background gets an alpha channel in ARGB32 (for example Meld Studio). Apps that request NV12 (Discord, browsers, OBS) see the background in the color below.");
                                }
                            }
                        }
                        if root.effect-index == 1: GroupBox {
                            title: @tr("Blur");
                            VerticalBox {
                                LabeledSlider {
                                    label: @tr("Blur strength");
                                    value <=> root.blur-strength;
                                    edited => {
                                        root.settings-edited();
                                    }
                                }
                                Hint {
                                    text: @tr("The blur is computed on a downscaled background, so its strength barely affects resource usage.");
                                }
                            }
                        }
                        if root.effect-index == 2 || root.effect-index == 4: GroupBox {
                            title: root.effect-index == 2 ? @tr("Background color") : @tr("Background color for apps without transparency");
                            VerticalBox {
                                HorizontalBox {
                                    padding: 0;
                                    Button {
                                        text: "Green screen";
                                        clicked => {
                                            root.color-preset("#00B140");
                                        }
                                    }
                                    Button {
                                        text: "Blue screen";
                                        clicked => {
                                            root.color-preset("#0047BB");
                                        }
                                    }
                                }
                                HorizontalBox {
                                    padding: 0;
                                    Rectangle {
                                        width: 36px;
                                        height: 28px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #5a5f66;
                                        background: root.color-swatch;
                                    }
                                    LineEdit {
                                        placeholder-text: "#RRGGBB";
                                        text <=> root.color-text;
                                        accepted => {
                                            root.settings-edited();
                                        }
                                    }
                                }
                                Hint {
                                    text: @tr("Type any color in hexadecimal and press Enter.");
                                }
                            }
                        }
                        if root.effect-index == 3: GroupBox {
                            title: @tr("Background image");
                            VerticalBox {
                                Text {
                                    text: root.image-path == "" ? @tr("No image selected") : root.image-path;
                                    wrap: word-wrap;
                                }
                                Button {
                                    text: @tr("Choose a PNG or JPEG image…");
                                    clicked => {
                                        root.choose-image();
                                    }
                                }
                                Hint {
                                    text: @tr("The image is scaled once when it changes, with no per-frame cost.");
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: @tr("Masking");
                ScrollView {
                    VerticalBox {
                        alignment: start;
                        GroupBox {
                            title: @tr("Method");
                            VerticalBox {
                                ComboBox {
                                    model: [@tr("RVM – accurate"), @tr("MediaPipe – lightweight")];
                                    current-index <=> root.method-index;
                                    selected => {
                                        root.settings-edited();
                                    }
                                }
                                Hint {
                                    text: root.method-index == 0 ? @tr("Robust Video Matting remembers previous frames, which keeps hair and edges stable. Best quality, more GPU work.") : @tr("MediaPipe Selfie Segmentation computes a small 256×256 mask. Very light, but edges are less accurate and need smoothing.");
                                }
                            }
                        }
                        GroupBox {
                            title: @tr("Quality and device");
                            VerticalBox {
                                Text {
                                    text: @tr("Model resolution");
                                }
                                ComboBox {
                                    enabled: root.method-index == 0;
                                    model: root.quality-names;
                                    current-index <=> root.quality-index;
                                    selected => {
                                        root.settings-edited();
                                    }
                                }
                                Hint {
                                    text: @tr("Automatic: the variant with the camera's aspect ratio and the largest resolution not bigger than the image. A higher resolution gives more accurate edges at the cost of GPU time.");
                                }
                                Text {
                                    text: @tr("Device");
                                }
                                ComboBox {
                                    model: ["GPU (DirectML)", "CPU"];
                                    current-index <=> root.device-index;
                                    selected => {
                                        root.settings-edited();
                                    }
                                }
                                Hint {
                                    text: @tr("The GPU computes the mask, blur and compositing without loading the processor. CPU works everywhere but uses much more processor time.");
                                }
                            }
                        }
                        GroupBox {
                            title: @tr("Mask tuning");
                            VerticalBox {
                                LabeledSlider {
                                    label: @tr("Lower edge threshold");
                                    value <=> root.edge-low;
                                    edited => {
                                        root.settings-edited();
                                    }
                                }
                                LabeledSlider {
                                    label: @tr("Upper edge threshold");
                                    value <=> root.edge-high;
                                    edited => {
                                        root.settings-edited();
                                    }
                                }
                                Hint {
                                    text: @tr("Moving the thresholds closer gives a sharper edge and less background showing through. Moving them apart gives a soft transition.");
                                }
                                LabeledSlider {
                                    label: @tr("Temporal smoothing");
                                    value <=> root.smoothing;
                                    edited => {
                                        root.settings-edited();
                                    }
                                }
                                Hint {
                                    text: @tr("Averages the mask across frames and removes flicker. Too high a value leaves trails when moving. Negligible cost.");
                                }
                                Button {
                                    text: @tr("Restore model defaults");
                                    clicked => {
                                        root.reset-mask();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: @tr("About");
                ScrollView {
                    VerticalBox {
                        alignment: start;
                        HorizontalBox {
                            padding: 0;
                            Image {
                                source: @image-url("../assets/chromafree-256.png");
                                width: 72px;
                                height: 72px;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "ChromaFree";
                                    font-size: 22px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: @tr("Version {}", root.app-version);
                                    color: #c9ccd1;
                                }
                                Text {
                                    text: @tr("Author: {}", root.app-author);
                                    color: #c9ccd1;
                                }
                            }
                        }
                        Text {
                            text: @tr("A virtual camera that removes, replaces or blurs the background of your webcam image. The image is processed locally on the graphics card and never sent anywhere.");
                            wrap: word-wrap;
                        }
                        GroupBox {
                            title: @tr("License");
                            VerticalBox {
                                Hint {
                                    text: @tr("ChromaFree is free software licensed under the GNU GPL version 3 or later. You can use, modify and distribute it under its terms. The program comes with no warranty. The source code is available on the project page.");
                                }
                            }
                        }
                        GroupBox {
                            title: @tr("Third-party components");
                            VerticalBox {
                                Hint {
                                    text: @tr("Robust Video Matting (GPL-3.0), MediaPipe Selfie Segmentation (Apache-2.0), ONNX Runtime (MIT), DirectML (Microsoft), Slint (GPL-3.0), windows-rs and tray-icon (MIT/Apache-2.0). The full list with licenses is in THIRD_PARTY.md in the installation folder.");
                                }
                            }
                        }
                        HorizontalBox {
                            padding: 0;
                            Button {
                                text: @tr("Project page");
                                clicked => {
                                    root.open-project();
                                }
                            }
                            Button {
                                text: @tr("Join the Discord server");
                                clicked => {
                                    root.open-discord();
                                }
                            }
                            Button {
                                text: @tr("Log folder");
                                clicked => {
                                    root.open-logs();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
